{% trans_default_domain('users-profile-balance.admin') %}

<div class="modal-dialog modal-dialog-centered" style="max-width: 800px;">
    {{ form_start(form) }}
    <div class="modal-content p-3 border-bottom border-5 border-danger">
        <div class="modal-header">

            <h5 class="modal-title">
                {# Заголовок модального окна #}
                {{ 'page.edit'|trans }}

            </h5>

            <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" title="Закрыть">
                <span class="svg-icon svg-icon-2x"></span>
            </div>
        </div>

        <div class="modal-body">
            {{ form_row(form.debt.debt, { label: 'Сумма задолженности' }) }}
            {{ form_row(form.debt.balance, { label: 'Сумма на балансе' }) }}
        </div>

        <div class="modal-footer">

            {# Отмена #}
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                {{ 'btn.cancel'|trans({}, 'core.btn') }}
            </button>

            {# Удалить #}
            {{ form_widget(form.edit_profile_balance, { label: '
				<span>'~ 'btn.save'|trans({}, 'core.btn') ~'</span>
				<span class="spinner-border spinner-border-sm vertical-middle d-none"></span>
			'}) }}

        </div>
    </div>
    {{ form_end(form) }}
</div>